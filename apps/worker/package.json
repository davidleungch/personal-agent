{
  "name": "@personal-agent/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --eval \"import('./src/index.ts').then(({ startWorker }) => startWorker(3001))\"",
    "start": "node --input-type=module --eval \"import('./dist/index.js').then(({ startWorker }) => startWorker(3001))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@personal-agent/agents": "workspace:*",
    "@personal-agent/db": "workspace:*",
    "@personal-agent/shared": "workspace:*",
    "@personal-agent/tools": "workspace:*",
    "croner": "10.0.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  }
}
