{
  "name": "@personal-agent/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "development": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx --eval \"import('./src/migrate-cli.ts').then(({ migrateFromEnvironment }) => migrateFromEnvironment(process.env))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@personal-agent/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12"
  }
}
