# External integrations are optional. Leave credential file paths unset to keep
# the corresponding capability unavailable.
DATABASE_URL=postgresql://personal_agent:personal_agent_local@postgres:5432/personal_agent
BROWSER_PROFILE_DIR=/var/lib/personal-agent/browser-profile
OPENAI_API_KEY_FILE=
GOOGLE_CLIENT_ID_FILE=
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_REFRESH_TOKEN_FILE=

# Concrete provider IDs are configuration. Durable domain state uses only the
# semantic profiles fast, balanced, and reasoning.
MODEL_FAST=gpt-5.6-luna
MODEL_BALANCED=gpt-5.6-terra
MODEL_REASONING=gpt-5.6-sol
