# External integrations are optional. Leave credential file paths unset to keep
# the corresponding capability unavailable.
DATABASE_URL=postgresql://personal_agent:personal_agent_local@postgres:5432/personal_agent
BROWSER_PROFILE_DIR=/var/lib/personal-agent/browser-profile
OPENAI_API_KEY_FILE=
GOOGLE_CLIENT_ID_FILE=
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_REFRESH_TOKEN_FILE=

# Concrete provider IDs are configuration. Durable domain state uses only the
# semantic profiles fast, balanced, and reasoning.
MODEL_FAST=gpt-5.6-luna
MODEL_BALANCED=gpt-5.6-terra
MODEL_REASONING=gpt-5.6-sol

# Deterministic per-run model budgets. Tool-attempt limits remain owned by each
# Tool Gateway policy.
AGENT_MAX_MODEL_INVOCATIONS=12
AGENT_MAX_REASONING_RETRIES=1
AGENT_MAX_ESCALATION_DEPTH=2

# Host-level Phase 2A development-runner settings. These do not belong in the
# app or worker Compose services. Keep DEVELOPMENT_PI_AGENT_DIR separate from
# personal ~/.pi/agent state and store its credential files outside the repo.
DEVELOPMENT_PI_AGENT_DIR=
DEVELOPMENT_REPOSITORY_PATH=
DEVELOPMENT_WORKSPACE_ROOT=/tmp/personal-agent-development-workspaces
DEVELOPMENT_SANDBOX_IMAGE=personal-agent-development-sandbox:local
DEVELOPMENT_RUNNER_ID=
DEVELOPMENT_MODEL_FAST_PROVIDER=openai
DEVELOPMENT_MODEL_BALANCED_PROVIDER=openai
DEVELOPMENT_MODEL_REASONING_PROVIDER=openai
