{
  "name": "personal-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "22.19.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @personal-agent/app --filter @personal-agent/worker dev",
    "lint": "eslint .",
    "smoke:live": "node --import tsx packages/tools/test/live-smoke.mts",
    "test": "node run-tests.mjs",
    "test:coverage": "node run-tests.mjs --coverage",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
